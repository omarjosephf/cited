# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used to generate answers.
# claude-opus-5    — strongest reasoning, ~$0.03 per question
# claude-haiku-4-5 — ~4x cheaper at ~$0.007 per question
ASSISTANT_MODEL=claude-opus-5

# Retrieval tuning.
# TOP_K            — how many passages are retrieved and shown to the model.
# MIN_SIMILARITY   — below this, the assistant refuses instead of answering.
#                    Measured during the M0 spike: a well-matched passage scored
#                    ~0.69 and an unrelated one ~0.32, so 0.45 sits in the gap.
#                    Re-tune against eval/questions.yaml, not by intuition.
TOP_K=5
MIN_SIMILARITY=0.45

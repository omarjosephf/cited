# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — never commit. .env.example carries the names only.
.env
.env.*
!.env.example

# Local indexes and caches. The index is derived from content/ and is rebuilt by
# `doc-assistant ingest`; committing it would bloat the repo and go stale.
.index/
.fastembed_cache/

# Evaluation output — the question set is committed, the run results are not.
eval/results/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Deployment staging. Corpus artifacts are generated by the repository that owns
# the content and copied in at build time; only the directory and its README are
# tracked. Committing a generated corpus here would create a second editable copy
# of someone's public claims, which is exactly the drift the checksum exists to
# catch.
deploy/*
!deploy/.gitkeep
!deploy/README.md
